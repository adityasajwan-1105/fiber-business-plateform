# Shared MongoDB Atlas Connection (used by Next.js API routes and Vercel)
# For all collaborators and deployed sites to share the same catalog,
# configure MONGODB_URI in your .env.local and in Vercel Project Settings:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.iaghazm.mongodb.net/madeye?retryWrites=true&w=majority&appName=Cluster0

# Authentication secrets
JWT_SECRET=your-secure-jwt-secret-here
ADMIN_EMAIL=admin@madeyeenterprises.com
ADMIN_PASSWORD=YourAdminPassword123!
ADMIN_INVITE_CODE=MeInvite#7kQ2

# If running the separate Express backend locally, keep this set:
NEXT_PUBLIC_API_URL=http://localhost:5000/api
# On Vercel, leave NEXT_PUBLIC_API_URL UNSET so it uses Next.js serverless /api routes

# Optional Cloudflare Images delivery base URL
NEXT_PUBLIC_CLOUDFLARE_IMAGES_DELIVERY_BASE_URL=https://imagedelivery.net/your-account-hash
